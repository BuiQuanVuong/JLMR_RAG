# Copy this file to .env and put your Anthropic API key below (https://platform.claude.com).
# The key is only needed for Claude features (ask, chat, compare, reading, topic names, recent advances);
# search, similar papers, the topic map and BibTeX export work without it. Keep .env private.
ANTHROPIC_API_KEY=paste-your-key-here

# Optional: where things live (defaults shown)
# JMLR_PAPERS_DIR=./papers
# JMLR_RAG_DATA=./data
